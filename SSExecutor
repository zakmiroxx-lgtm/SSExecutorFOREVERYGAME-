local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "AntiCheatWarning"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local messages = {
    "🚨 ЧИТЕРИТЬ — ЭТО ПЛОХО!",
    "⚠️ НЕ ИСПОЛЬЗУЙ ЧИТЫ!",
    "❌ ЧИТЫ ПОРТЯТ ИГРУ!",
    "🚫 ТЫ НАРУШАЕШЬ ПРАВИЛА!",
    "⚠️ ПРЕКРАТИ ЧИТЕРИТЬ!",
    "🚨 FAIR PLAY!"
}

-- Уведомления Roblox
task.spawn(function()
    for i = 1, 25 do
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🚨 АНТИЧИТ",
                Text = messages[math.random(1, #messages)],
                Duration = 3
            })
        end)
        task.wait(0.5)
    end
end)

-- Заполнение экрана предупреждениями
task.spawn(function()
    for i = 1, 100 do
        local warning = Instance.new("TextLabel")
        warning.Size = UDim2.new(0, math.random(180, 350), 0, 65)
        warning.Position = UDim2.new(
            math.random(0, 75) / 100,
            0,
            math.random(0, 90) / 100,
            0
        )

        warning.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        warning.BackgroundTransparency = 0.1
        warning.BorderSizePixel = 2
        warning.BorderColor3 = Color3.fromRGB(255, 255, 255)

        warning.Text = messages[math.random(1, #messages)]
        warning.TextColor3 = Color3.fromRGB(255, 255, 255)
        warning.TextScaled = true
        warning.Font = Enum.Font.GothamBold
        warning.Rotation = math.random(-15, 15)
        warning.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = warning

        task.wait(0.12)
    end
end)

-- Кик через 15–20 секунд
task.wait(math.random(15, 20))

player:Kick("Вы считерили.")
